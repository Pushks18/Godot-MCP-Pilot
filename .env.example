# Absolute path to the Godot 4 executable.
# If unset, godot-mcp searches common install locations automatically.
# macOS example: /Applications/Godot.app/Contents/MacOS/Godot
# Linux example: /usr/bin/godot4
# Windows example: C:\Program Files\Godot\Godot.exe
GODOT_PATH=

# Set to "true" to disable all write tools (safe for CI / read-only review).
READ_ONLY_MODE=false

# Set to "true" to print debug information to stderr.
DEBUG=false
