{
  "name": "godot-mcp-pilot",
  "version": "1.0.0",
  "description": "MCP server for AI-driven Godot game development — launch editor, run projects, edit scenes and scripts via natural language",
  "main": "build/index.js",
  "bin": {
    "godot-mcp-pilot": "build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node build/index.js",
    "prepare": "npm run build",
    "setup": "node scripts/setup.js",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "keywords": [
    "godot",
    "mcp",
    "model-context-protocol",
    "game-development",
    "ai",
    "claude",
    "cursor",
    "gdscript"
  ],
  "author": "Pushkaraj Baradkar",
  "license": "MIT",
  "homepage": "https://pushks18.github.io/godot-mcp-pilot",
  "repository": {
    "type": "git",
    "url": "https://github.com/pushks18/godot-mcp-pilot.git"
  },
  "bugs": {
    "url": "https://github.com/pushks18/godot-mcp-pilot/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitepress": "^1.6.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
